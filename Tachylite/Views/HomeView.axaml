<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tachylite.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Tachylite.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <StackPanel Orientation="Horizontal">
    <StackPanel Orientation="Vertical">
      <ItemsControl ItemsSource="{Binding RecentsButtons}">

      </ItemsControl>
    </StackPanel>
    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Label Content=""></Label>
        <TextBox Name="openPath"
            Text="{Binding Path}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PlaceholderText="Path to an existing Chest..." />
        <Button Content="Browse" Click="BrowseButton_Click"></Button>
        <Button Content="Open" Command="{Binding OpenChest}"></Button>
        <Button Content="Create New Chest" ClickMode="Press" Command="{Binding NewChest}"></Button>
    </StackPanel>
  </StackPanel>
</UserControl>
