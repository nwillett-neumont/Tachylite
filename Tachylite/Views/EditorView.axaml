<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:local="using:Tachylite.Views"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:Tachylite.ViewModels"
            xmlns:views="using:Tachylite.Views"
            xmlns:models="using:Tachylite.Models"
            xmlns:svg="clr-namespace:Avalonia.Svg.Skia;assembly=Svg.Controls.Skia.Avalonia"
            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:Class="Tachylite.Views.EditorView"
            x:DataType="vm:EditorViewModel">
  <!-- Styles for validation -->
  <UserControl.Styles>
    <Style Selector="TextBox.invalid">
      <Setter Property="BorderBrush" Value="Red" />
      <Setter Property="PlaceholderText" Value="Path must point to a valid chest" />
    </Style>
  </UserControl.Styles>

  <!-- Flyout menu for extra controls, I don't technically need this, but I think it makes my stuff more readable -->
  <UserControl.Resources>
    <Flyout x:Key="ControlFlyout" Placement="Top">
      <Button Height="40" Width="40" Command="{Binding ToggleTemplateDialog}"><Image Source="{SvgImage avares://Tachylite/Assets/template-icon-dark.svg}" /></Button>
    </Flyout>
  </UserControl.Resources>

  <!-- Outermost grid that holds all of the stuff on the page -->
  <Grid>
    <Grid HorizontalAlignment="Stretch" RowDefinitions="Auto, *, Auto" >
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="15*" MinWidth="190" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="85*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <!-- Top Controls -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Spacing="8" Grid.Column="0" Grid.Row="0">
        <Button MaxHeight="40" MaxWidth="40" Command="{Binding ToggleCreateMarkdownDialog}"><Image Source="{SvgImage avares://Tachylite/Assets/new-note-dark.svg}" /></Button>
        <Button MaxHeight="40" MaxWidth="40" Command="{Binding ToggleImportPdfDialog}"><Image Source="{SvgImage avares://Tachylite/Assets/import-pdf-dark.svg}" /></Button>
        <Button MaxHeight="40" MaxWidth="40" Command="{Binding ToggleNewFolderDialog}"><Image Source="{SvgImage avares://Tachylite/Assets/new-folder-dark.svg}" /></Button>
        <Button MaxHeight="40" MaxWidth="40" Command="{Binding ToggleDiceRollerDialog}"><Image Source="{SvgImage avares://Tachylite/Assets/die-icon-dark.svg}" /></Button>
      </StackPanel>
      <!-- FileTree -->
      <TreeView ItemsSource="{Binding FileTree}" Background="Transparent" Grid.Column="0" Grid.Row="1">
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
          </Style>
        </TreeView.Styles>
        <TreeView.ContextMenu>
          <ContextMenu>
            <MenuItem Header="Create New Markdown File"
                      Command="{Binding ToggleContextMenuCreateMarkdownDialogCommand}"
                      CommandParameter="{Binding ChestPath}"  />
            <MenuItem Header="Import PDF File"
                      Command="{Binding ToggleContextMenuImportPdfDialogCommand}"
                      CommandParameter="{Binding ChestPath}"  />
            <MenuItem Header="Create New Folder"
                      Command="{Binding ToggleContextMenuNewFolderDialogCommand}"
                      CommandParameter="{Binding ChestPath}"  />
          </ContextMenu>
        </TreeView.ContextMenu>
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="models:FolderTreeNode" ItemsSource="{Binding Children}">
            <Border ToolTip.Tip="{Binding Path}" ToolTip.ShowDelay="1800" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Left" />
              <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Rename Folder" 
                              Command="{Binding RenameCommand}"
                              CommandParameter="{Binding Path}" />
                    <MenuItem Header="Create New Markdown File" 
                              Command="{Binding CreateMarkdownFileCommand}"
                              CommandParameter="{Binding Path}" />
                    <MenuItem Header="Import PDF File" 
                              Command="{Binding ImportPdfFileCommand}"
                              CommandParameter="{Binding Path}" />
                    <MenuItem Header="Create New Folder" 
                              Command="{Binding CreateFolderCommand}"
                              CommandParameter="{Binding Path}" />
                  </ContextMenu>
                </Border.ContextMenu>
            </Border>
          </TreeDataTemplate>
          <TreeDataTemplate DataType="models:FileTreeNode">
            <Border ToolTip.Tip="{Binding Path}" ToolTip.ShowDelay="1800" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" PointerPressed="Click_FileButton">
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Left" />
              <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Rename File" 
                              Command="{Binding RenameCommand}"
                              CommandParameter="{Binding Path}" />
                  </ContextMenu>
                </Border.ContextMenu>
            </Border>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </TreeView>
      <!-- Bottom Controls -->
      <Grid VerticalAlignment="Bottom"
            ColumnDefinitions="*,Auto,Auto"
            Grid.Column="0"
            Grid.Row="2">
        <Viewbox Stretch="Uniform" StretchDirection="Both" MaxHeight="18">
          <TextBlock Text="{Binding ChestName}"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  ToolTip.Tip="{Binding ChestPath}"
                  Margin="8,0,8,0"
                  Grid.Column="0" />
        </Viewbox>
        <Button MaxHeight="40" MaxWidth="40" Margin="0,0,8,0" Flyout="{StaticResource ControlFlyout}" Grid.Column="1">
          <Image Source="{SvgImage avares://Tachylite/Assets/menu-icon-dark.svg}" />
        </Button>
        <Button MaxHeight="40" MaxWidth="40" Margin="0,0,8,0" Command="{Binding CloseChest}" Grid.Column="2">
          <Image Source="{SvgImage avares://Tachylite/Assets/close-folder-dark.svg}" />
        </Button>
      </Grid>
      <GridSplitter ResizeBehavior="BasedOnAlignment" ResizeDirection="Columns" Background="DarkGray" Width="1" CornerRadius="12" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" />
      
      <!-- Tabs -->
      <TabControl ItemsSource="{Binding Tabs}" 
                  SelectedItem="{Binding CurrentTab}"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Grid.Column="2"
                  Grid.Row="0"
                  Grid.RowSpan="3" />
      <Grid Grid.Column="2"
            Grid.Row="0"
            Grid.RowSpan="3">
        
        <!-- Modals -->
        <Border IsVisible="{Binding IsCreateMarkdownDialogVisible}" 
                Margin="20" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemControlTransientBackgroundBrush}"
                CornerRadius="12"
                Padding="24">
          <StackPanel Orientation="Vertical"  Spacing="8">
            <TextBox Text="{Binding NewFileName}" PlaceholderText="Name for new file..." Classes.invalid="{Binding FileNameIsInvalid}" ></TextBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Name="newFilePath" Text="{Binding NewFilePath}" PlaceholderText="Path to put file in..." Classes.invalid="{Binding NewFilePathDoesNotExistInChest}" IsEnabled="{Binding NewFilePathIsEnabled}" ></TextBox>
              <Button Content="Browse" Click="ButtonNewFile_Click" IsEnabled="{Binding NewFilePathIsEnabled}"/> 
            </StackPanel>
            <StackPanel Orientation="Horizontal" 
                        Spacing="8"
                        HorizontalAlignment="Center">
              <Button Content="Cancel" Command="{Binding ToggleCreateMarkdownDialog}" />
              <Button Content="Create" Command="{Binding CreateMarkdownFile}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsImportPdfDialogVisible}"
                Margin="20" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemControlTransientBackgroundBrush}"
                CornerRadius="12"
                Padding="24">
          <StackPanel Orientation="Vertical" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Name="sourcePdfPath" Text="{Binding ExistingPdfPath}" PlaceholderText="Path to PDF file..." Classes.invalid="{Binding PdfFilePathIsInvalid}" ></TextBox>
              <Button Content="Browse" Click="ButtonImportPdfSource_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox Name="newPdfPath" Text="{Binding NewPdfPath}" PlaceholderText="Path put file in..." Classes.invalid="{Binding NewPdfPathDoesNotExistInChest}" IsEnabled="{Binding NewPdfPathIsEnabled}" ></TextBox>
                <Button Content="Browse" Click="ButtonImportPdfDestination_Click" IsEnabled="{Binding NewPdfPathIsEnabled}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" 
                        Spacing="8"
                        HorizontalAlignment="Center">
              <Button Content="Cancel" Command="{Binding ToggleImportPdfDialog}" />
              <Button Content="Import" Command="{Binding ImportPdfFile}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsNewFolderDialogVisible}"
                Margin="20" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemControlTransientBackgroundBrush}"
                CornerRadius="12"
                Padding="24">
          <StackPanel Orientation="Vertical" Spacing="8">
            <TextBox Text="{Binding NewFolderName}" PlaceholderText="Name for the new folder..." Classes.invalid="{Binding FolderNameIsInvalid}" ></TextBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Name="newFolderPath" Text="{Binding NewFolderPath}" PlaceholderText="Path put folder in..." Classes.invalid="{Binding NewFolderPathDoesNotExistInChest}" IsEnabled="{Binding NewFolderPathIsEnabled}"></TextBox>
              <Button Content="Browse" Click="ButtonNewFolder_Click" IsEnabled="{Binding NewFolderPathIsEnabled}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" 
                        Spacing="8"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button Content="Cancel" Command="{Binding ToggleNewFolderDialog}" />
              <Button Content="Create" Command="{Binding CreateFolder}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsRenameDialogVisible}"
                Margin="20" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemControlTransientBackgroundBrush}"
                CornerRadius="12"
                Padding="24">
          <StackPanel Orientation="Vertical" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Name="renamePath" Text="{Binding RenamePath}" PlaceholderText="Path to renamed item..." Classes.invalid="{Binding RenamePathIsInvalid}" IsEnabled="{Binding RenameEntryIsEnabled}"></TextBox>
              <Button Content="Browse" Click="ButtonRename_Click" IsEnabled="{Binding RenameEntryIsEnabled}"/>
            </StackPanel>    
            <TextBox Text="{Binding RenameNewName}" PlaceholderText="New name..." Classes.invalid="{Binding RenameDestinationPathIsInvalid}" ></TextBox>
            <StackPanel Orientation="Horizontal" 
                        Spacing="8"
                        HorizontalAlignment="Center">
              <Button Content="Cancel" Command="{Binding ToggleRenameDialog}" />
              <Button Content="Rename" Command="{Binding Rename}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsNewTemplateDialogVisible}" 
                Margin="20" 
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemControlTransientBackgroundBrush}"
                CornerRadius="12"
                Padding="24">
          <StackPanel Orientation="Vertical" Spacing="8">
            <TextBlock Margin="16" 
                      Padding="16"
                      TextWrapping="Wrap"
                      FontSize="16"
                      HorizontalAlignment="Center">
              Templates allow you to save the current structure of a chest.
              When you create a template all files and folders will be stored in a new template.
              Then, when you go to create a new template, you can select the template you created and it will create the new chest with all the stuff this one currently has!
                      </TextBlock>
            <Label Target="templateTextBox" HorizontalAlignment="Center">Name for the new template:</Label>
            <TextBox Name="templateTextBox" HorizontalAlignment="Center" Text="{Binding NewTemplateName}" PlaceholderText="Name for new template..." Classes.invalid="{Binding NewTemplateNameIsInvalid}" ></TextBox>
            <StackPanel Orientation="Horizontal" 
                        Spacing="8"
                        HorizontalAlignment="Center">
              <Button Content="Cancel" Command="{Binding ToggleTemplateDialog}" />
              <Button Content="Create" Command="{Binding CreateTemplate}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsDiceRollerVisible}"
                Margin="20" 
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{DynamicResource SystemControlTransientBackgroundBrush}"
                CornerRadius="12"
                Padding="24">
          <ScrollViewer>
            <views:DiceRollerView DataContext="{Binding DiceRoller}"/>
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
