<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tachylite.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Tachylite.Views.NewChestView"
             x:DataType="vm:NewChestViewModel">
  <UserControl.Styles>
    <Style Selector="TextBox.invalid">
      <Setter Property="BorderBrush" Value="Red" />
      <Setter Property="PlaceholderText" Value="Path must point to a valid chest" />
    </Style>
  </UserControl.Styles>
  <StackPanel Orientation="Vertical"
    VerticalAlignment="Center"
    HorizontalAlignment="Center"
    Spacing="8">
    <TextBox Text="{Binding Name}"
      MinWidth="200"
      PlaceholderText="Name of your new Chest..."
      Classes.invalid="{Binding NameIsInvalid}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox Name="newChestPath"
        MinWidth="240"
        Text="{Binding NewChestPath}"
        PlaceholderText="Path to create the Chest in..."
        Classes.invalid="{Binding CreatePathIsInvalid}" />
      <Button Content="Browse" Click="BrowseButton_Click"></Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal"
      VerticalAlignment="Center"
      HorizontalAlignment="Center"
      Spacing="8">
      <Button Content="Cancel" Command="{Binding CancelCreate}"></Button>
      <Button Content="Create" Command="{Binding CreateChest}"></Button>
    </StackPanel>
  </StackPanel>
</UserControl>
