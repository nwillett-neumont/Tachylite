<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Tachylite.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Tachylite.Views.NewChestView"
             x:DataType="vm:NewChestViewModel">
  <StackPanel Orientation="Vertical">
    <TextBox Text="{Binding Name}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PlaceholderText="Name of your new Chest..." />
    <TextBox Name="newChestPath"
        Text="{Binding NewChestPath}"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        PlaceholderText="Path to create the Chest in..." />
    <Button Content="Browse" Click="BrowseButton_Click"></Button>
    <Button Content="Create" Command="{Binding CreateChest}"></Button>
  </StackPanel>
</UserControl>
