<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:Tachylite.ViewModels"
            xmlns:views="using:Tachylite.Views"
            xmlns:local="using:Tachylite"
            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
            x:Class="Tachylite.Views.MarkdownEditorView"
            x:DataType="vm:MarkdownEditorViewModel">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RowDefinitions="5*, 95*">
        <Button x:Name="SwitchButton" HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding SwitchView}" Content="{Binding SwitchButtonText}"></Button>
        <Panel IsVisible="{Binding EditorIsVisible}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="1">
            <TextBox Text="{Binding FilePath, Mode=OneWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"></TextBox>
        </Panel>
        <Panel IsVisible="{Binding PreviewIsVisible}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="1">
            <NativeWebView Name="webView" local:NativeWebViewHtmlSource.HtmlSource="{Binding MarkdownHtml}"></NativeWebView>
        </Panel>
    </Grid>
</UserControl>
